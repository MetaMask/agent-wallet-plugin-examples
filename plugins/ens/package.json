{
  "name": "ens",
  "version": "0.1.0",
  "description": "ENS name resolution for the MetaMask agent wallet CLI (mm)",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "oclif-plugin"
  ],
  "files": [
    "dist",
    "oclif.manifest.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && oclif manifest",
    "prepack": "npm run build"
  },
  "oclif": {
    "bin": "mm",
    "commands": "./dist/commands",
    "topicSeparator": " ",
    "topics": {
      "ens": {
        "description": "Resolve ENS names and addresses"
      }
    }
  },
  "mm": {
    "schemaVersion": 1,
    "minCliVersion": "^6.2.0",
    "capabilities": [
      "wallet-read"
    ],
    "commands": [
      {
        "id": "ens:resolve",
        "capabilities": [
          "wallet-read"
        ],
        "dataAccess": []
      }
    ]
  },
  "peerDependencies": {
    "@metamask/agent-wallet": "^6.2.0"
  },
  "dependencies": {
    "viem": "^2.35.0"
  },
  "devDependencies": {
    "@metamask/agent-wallet": "^6.2.0",
    "oclif": "^4",
    "typescript": "^5"
  }
}
